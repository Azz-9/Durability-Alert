{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",

	"name": "${mod_name}",
	"description": "${description}",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"issues": "https://github.com/Azz-9/Durability-Alert/issues",
		"sources": "https://github.com/Azz-9/Durability-Alert"
	},

	"license": "${license}",
	"icon": "${mod_id}.png",

	"environment": "client",
	"entrypoints": {
		"main": [
			"me.Azz_9.durability_alert.DurabilityAlert"
		],
		"modmenu": [
			"me.Azz_9.durability_alert.compat.ModMenuCompat"
		]
	},

	"mixins": [
		"${mod_id}.mixins.json",
		"${mod_id}.fabric.mixins.json"
	],

	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}
  